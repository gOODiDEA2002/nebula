# proxy-pool 运行时环境变量示例
# 用法: cp .env.example .env 并填入真实值; .env 已被 .gitignore/.dockerignore 排除, 不会入库或进镜像
# docker compose 会自动读取同目录下的 .env 做变量替换

# Redis 连接串(必填, 无默认值): redis://:<password>@<host>:<port>/<db>
# 复用 sia-net 上的 sia-redis
DB_CONN=redis://:CHANGE_ME@sia-redis:6379/10

# API 访问 token(可选): 设置后, 除健康检查 "/" 外所有接口需携带
#   请求头 X-API-Token: <token>  或  查询参数 ?token=<token>
# 留空则不启用鉴权(保持与上游 jhao104/proxy_pool 一致的开放行为)
API_TOKEN=

# 监听地址/端口(可选, 容器内默认 0.0.0.0:5010)
# HOST=0.0.0.0
# PORT=5010
